<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackAsTool>true</PackAsTool>
    <PackageId>Fennec.Labs</PackageId>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <ToolCommandName>fennec</ToolCommandName>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.55.2" />
    <PackageReference Include="System.CommandLine" Version="2.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FennecLabs.DotNetCli\FennecLabs.DotNetCli.csproj" />
    <ProjectReference Include="..\FennecLabs.NuGet\FennecLabs.NuGet.csproj" />
    <ProjectReference Include="..\FennecLabs.Scorecard\FennecLabs.Scorecard.csproj" />
    <ProjectReference Include="..\FennecLabs.Instrumentation\FennecLabs.Instrumentation.csproj" />
    <ProjectReference Include="..\FennecLabs.AssemblyDiff\FennecLabs.AssemblyDiff.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="FennecLabs.Instrumentation/**" />
    <None Remove="FennecLabs.Instrumentation/**" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>FennecLabs.Cli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
